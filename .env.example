# --- Server ---
PORT=4021
PUBLIC_URL=https://anvil.example.com
# mainnet | testnet
ALGORAND_NETWORK=mainnet
# Receiving address (must be opted in to USDC). Leave empty to run WITHOUT payments (dev only).
PAY_TO=
FACILITATOR_URL=https://facilitator.goplausible.xyz
# Optional overrides (defaults: Nodely free endpoints / network USDC ASA)
ALGOD_URL=
INDEXER_URL=
USDC_ASA=
# 25-word mnemonic of a low-balance account that writes receipt notes (0.001 ALGO each)
RECEIPT_MNEMONIC=

# --- Artifact storage (Cloudflare R2 or any S3-compatible) ---
S3_ENDPOINT=http://localhost:7070
# "auto" for Cloudflare R2; "us-east-1" for the local versitygw
S3_REGION=us-east-1
S3_BUCKET=anvil
S3_ACCESS_KEY_ID=anvil
S3_SECRET_ACCESS_KEY=anvil-secret
# Optional hard cap on total bucket bytes; new jobs get 503 (unpaid) within 50 MB of it
STORAGE_CAP_BYTES=
# Signed artifact URL lifetime (default 7 days)
ARTIFACT_URL_TTL_SECONDS=

# --- Limits ---
# Max POST body bytes (default 32 MiB; covers the ~20 MB base64 file inputs)
MAX_BODY_BYTES=
# Per-artifact byte cap; larger text artifacts are truncated, larger binaries dropped
MAX_ARTIFACT_BYTES=
# Concurrency caps: all jobs / Vercel sandboxes / remote-browser sessions
JOB_CONCURRENCY=
SANDBOX_CONCURRENCY=
BROWSER_CONCURRENCY=
# Allow http/private-network fetch targets (LOCAL DEV ONLY — disables the SSRF policy)
ALLOW_PRIVATE_TARGETS=

# --- Engines ---
BROWSER_WS_URL=ws://localhost:3001/
DOCLING_URL=http://localhost:5001
GOTENBERG_URL=http://localhost:3002
# Optional: Lighthouse scores in /v1/audit/site (free key, higher quota)
PAGESPEED_API_KEY=
# Seconds between /v1/monitor scheduler ticks
MONITOR_TICK_SECONDS=60
GEMINI_API_KEY=
# Comma-separated: later models are used when earlier ones return 429/5xx
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-2.5-flash-lite
# Google Search grounding (/v1/research/brief); free-tier keys only get grounding on 2.5 models
GEMINI_SEARCH_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite
# Vercel Sandbox (Firecracker microVMs, free Hobby plan) for /v1/run, /v1/analyze, /v1/test.
# Token: https://vercel.com/account/settings/tokens ; team + project ids from project settings.
# Run `pnpm sandbox:snapshot` once and paste the printed VERCEL_SANDBOX_SNAPSHOT.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_SANDBOX_SNAPSHOT=
