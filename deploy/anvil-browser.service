[Unit]
Description=anvil remote Chromium (playwright run-server)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/anvil
# Same browser engine the compose service runs, minus the container.
ExecStart=/home/ubuntu/anvil/node_modules/.bin/playwright run-server --port 3001 --host 127.0.0.1
Restart=always
RestartSec=5
MemoryMax=600M
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
